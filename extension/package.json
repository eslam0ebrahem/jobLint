{
  "name": "joblint-extension",
  "description": "manifest.json description",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test tests/e2e/discovery-flow.spec.ts",
    "test:e2e:firefox": "npm run build:firefox && playwright test --config playwright.firefox.config.ts && web-ext lint --source-dir .output/firefox-mv2 --no-input",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "verify:fixtures": "node scripts/generate-fixture-inspector.mjs --check",
    "inspect:fixtures": "node scripts/generate-fixture-inspector.mjs && vite --config tests/fixture-inspector/vite.config.ts",
    "smoke:gateway": "npm run build && node scripts/gateway-smoke.mjs",
    "test:watch": "vitest",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "eslint": "^10.10.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  }
}
